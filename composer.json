{
    "name": "zidnyal-hikammawarist/rapidstrat",
    "description": "Rapid Application Scaffolding, Multi-Role & Architecture Kit for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Zidny Al-Hikam Mawarist",
            "email": "zidni.hikam1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "barryvdh/laravel-dompdf": "Diperlukan untuk fitur cetak laporan PDF (composer require barryvdh/laravel-dompdf)"
    },
    "autoload": {
        "psr-4": {
            "Rapidstrat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rapidstrat\\RapidstratServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
