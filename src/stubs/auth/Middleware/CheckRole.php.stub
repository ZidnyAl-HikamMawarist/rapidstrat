<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

/**
 * ============================================================================
 * MIDDLEWARE OTORISASI BERBASIS PERAN (ROLE-BASED ACCESS CONTROL)
 * ============================================================================
 * Berfungsi sebagai "satpam pintu gerbang" untuk memeriksa apakah akun yang
 * sedang login memiliki role yang diizinkan untuk mengakses suatu rute.
 * 
 * Penggunaan di routes/web.php:
 * ->middleware('role:admin')
 * ->middleware('role:admin,petugas')
 * ============================================================================
 */
class CheckRole
{
    /**
     * Memproses request HTTP yang masuk dan mengecek izin akses pengguna.
     *
     * @param  \Illuminate\Http\Request  $request
     * @param  \Closure(\Illuminate\Http\Request): (\Symfony\Component\HttpFoundation\Response)  $next
     * @param  string  ...$roles Daftar role yang diizinkan (variadic parameter)
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function handle(Request $request, Closure $next, ...$roles): Response
    {
        // 1. Dapatkan objek user yang sedang login dari request
        $user = $request->user();

        // 2. Jika belum login sama sekali, arahkan ke form login
        if (!$user) {
            return redirect()->route('login')->with('error', 'Silakan masuk terlebih dahulu untuk mengakses halaman ini.');
        }

        // 3. Cocokkan role pengguna dengan daftar role yang diizinkan untuk rute ini
        if (!in_array($user->role, $roles, true)) {
            // Hentikan request dengan response HTTP 403 Forbidden
            abort(403, "Akses Ditolak! Akun dengan role [{$user->role}] tidak memiliki wewenang untuk membuka halaman ini.");
        }

        // 4. Jika lolos verifikasi, teruskan request ke controller tujuan
        return $next($request);
    }
}
